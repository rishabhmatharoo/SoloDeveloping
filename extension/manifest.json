{
  "manifest_version": 3,
  "name": "Daily Quest · 90-Day Routine Tracker",
  "version": "1.1.0",
  "description": "Solo Leveling style daily quest: AI-off office work, system design, AI concepts and twice-weekly DSA dungeons.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Daily Quest",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "tracker.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"]
}
